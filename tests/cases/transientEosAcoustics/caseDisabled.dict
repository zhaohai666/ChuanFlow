// E7c (5.183) enable-false witness: the acoustics block declared but
// switched off. Byte-identical to caseBase.dict outright (the disabled
// path never allocates the acoustic state and never emits a column).
fluid
{
    rhoL 1000;
    rhoG 11.61;
    muL  0.01;
    muG  1e-5;
    gasR 287;
}

pipe
{
    length 100;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 100;
}

closure
{
    model wallis;
}

initial
{
    alpha 0;
    water 0;
    temperature 300;
}

boundaries
{
    inlet { type sealed; }
    outlet { type sealed; }
}

acoustics
{
    enable false;
    initialGauge 1e6;
    soundSpeed 0;
    cfl 0.5;
    openEnd outlet;
}

time
{
    dt 0.001;
    endTime 2.0;
    reportEvery 5;
}
