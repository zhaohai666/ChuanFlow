# transientMultiSchedule: the multi-segment event tables. One tank blows
# down through one line whose valve runs TWO close-open cycles on a single
# `valveSchedule` event table -- the first reopen is a STEP (adjacent equal-t
# events: K holds 1e12 up to t = 8 and jumps to 20 at the instant), the
# second is a ramp back -- while a top-level `sourceSchedule` moves the
# injection rate through three piecewise-linear segments (up, hold, down,
# back up). Both tables are linear between events, hold their end values
# outside, and are evaluated at the implicit new time t + dt.
#
# The checker replicates the discrete (Q, p, alpha) series exactly, reading
# K(t) and rate(t) from the same closed-form tables, and adds physical
# anchors measured on this case:
#   * laminar throughout (max Re ~ 1100, inside Churchill's exact-64/Re
#     branch, which the exact replication relies on)
#   * the step at t = 8 is visible in the printed series: the flow frame
#     straddling it moves orders of magnitude more than any smooth-neighbour
#     frame
#   * closed window [6, 8]: K = 1e12 chokes the line to a ~1e-7 m3/s leak
#     while the source keeps filling the tank
#   * after the last events (valve 18, source 17) both tables HOLD: the
#     tail of the run repeats the same schedule values every step
fluid { rho 850; mu 0.1; }

nodes
{
    TANK { volume 5; bulkModulus 4.0e7; pressure 5.0e5; liquidFraction 0.8; }
    OUT  { fixedPressure 0; }
}

pipes
{
    LINE
    {
        from TANK; to OUT;
        length 100; diameter 0.05;
        valveSchedule
        {
            events
            {
                { t 0.0;  k 20.0; }
                { t 2.0;  k 20.0; }
                { t 6.0;  k 1.0e12; }
                { t 8.0;  k 1.0e12; }
                { t 8.0;  k 20.0; }   // step: hold closed, then instant reopen
                { t 10.0; k 20.0; }
                { t 14.0; k 1.0e12; }
                { t 16.0; k 1.0e12; }
                { t 18.0; k 20.0; }   // ramped reopen, hold to the end
            }
        }
    }
}

sourceSchedule
{
    node TANK;
    events
    {
        { t 0.0;  rate 0.0; }
        { t 4.0;  rate 0.002; }
        { t 9.0;  rate 0.002; }
        { t 12.0; rate 0.0; }
        { t 17.0; rate 0.001; }
    }
}

time { dt 0.02; endTime 20; reportEvery 1; }
