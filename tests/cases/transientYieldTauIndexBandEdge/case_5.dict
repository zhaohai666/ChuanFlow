// transientYieldTauIndexRelatch (case n = 0.5, K = 1.0): the tau_0 x flowIndex
// cross that 5.57 and 5.59 both left empty. 5.59 swept the index at ONE yield
// stress (tau_0 = 2.0 against a 1.5 neighbour) and found the re-latch present at
// n = 1 / 2 and absent at n = 0.5 -- and it could not say whether the absence was
// a property of the index or of that one threshold. 5.57 swept the index on the
// parking band and left "tau_0 x index" explicitly untested. This file closes
// that cell by sweeping BOTH axes on the same two-way latch desk.
//
// Four arms per file, one free node each, identical but for the strong wall's
// yield stress; the weak neighbour is tau_0 = 1.5 everywhere:
//
//   arm  tau_0(strong)  threshold 4 tau_0 L/d   release pressure pA - threshold
//    a      1.75            7000 Pa                 23000 Pa
//    b      2.0             8000 Pa                 22000 Pa   <- 5.59's arm a
//    c      2.25            9000 Pa                 21000 Pa
//    d      2.5            10000 Pa                 20000 Pa
//
// The row per arm is 5.54's / 5.59's, with Herschel-Bulkley walls:
//
//   rho L/A (Qk - Qk')/dt = (pA - pF) - 4 L tw_k / d
//   rho L/A (Qd - Qd')/dt = (pF - pB) - R Qd - Kd(t) rho|Qd|Qd/(2A^2)
//   V/BC (pF - pF')        = Q_S + Q_W - Q_d
//
// No kernel change: threshold (transient.cpp:28-:31), entry latch (:40-:43),
// in-step clamp (:353-:355, before kv is read), degree-generic node row
// (:395-:416). tau_0 enters ONLY through 4 tau_0 L/d, so the tau_0 axis moves the
// release pressure by exactly -4000 Pa per unit tau_0 while the index axis moves
// the refill that has to reach it -- the two axes are not interchangeable, and
// the point of the cross is to measure which one buys the sleep.
//
// Every free node starts at 2.7e4 Pa against A = 3.0e4, so the drive on offer is
// 3000 Pa and every wall starts held. The drain closes 0.8 -> 1.0 s to
// closedK = 1e8 and reopens 2.5 -> 2.7 s in every arm (first sealed sample 500,
// first reopened sample 1350). Constants are 5.57's/5.58's/5.59's: L 20, d 0.02,
// rho 850, mu 0.1, dt 0.002, endTime 4.0 (2001 states), volume 0.1,
// bulkModulus 1e8. This tier is (flowIndex, consistency) = (0.5, 1.0);
// case_1.dict is (1.0, 0.1), whose arm b is 5.59's arm a written in a new file
// and is compared against it token for token.
//
// verified by tests/check_transient_yield_tau_index_relatch.py
// (ctest verify.transientYieldTauIndexRelatch).
//
// Measured at (n, K) = (0.5, 1.0), 2001 states:
//
//   * the desk is blind to the neighbour's tau_0 -- the four weak walls all
//     release at [1, 180] in this tier, and the four arms are the SAME STRINGS
//     for the first 239 states (weak-wall rates and node alike). The prefix
//     ends exactly at the earliest strong wake [239, 318, 1479, 2001].
//   * thresholds 7000/8000/9000/10000 Pa (= 4 tau_0 L/d), release pressures
//     23000/22000/21000/20000, no n anywhere; wake at the FIRST entry drive
//     above -- 7005.6287 / 8001.7883 / 9003.2571 / --- Pa (overshoot
//     5.6287 / 1.7883 / 3.2571 Pa = 0.080 / 0.022 / 0.036%); arm d never
//     wakes, max entry drive 9802.5079 Pa, 197.4921 short of 10000.
//   * census: 2 AWAKE (a [1,239], b [1,318]), 1 LATE (c [1,1479]), 1 NEVER (d [1]).
//   * the refill barely knows the strong wall's tau_0 -- the sealed window's
//     best node moves only 51.36260 Pa across tau_0 = 1.75..2.5
//     (21448.40242 / 21400.49321 / 21397.03982 / 21397.03982), monotone
//     DECREASING in tau_0 (stronger neighbour supplies less).
//   * positive margin is not sufficient -- arm c's best node 21397.03982 Pa is
//     397.040 Pa ABOVE its release 21000 and yet all 851 sealed states print
//     flag 1, because it woke at step 1479, 129 steps AFTER the seal broke at
//     1350. The wall must be awake inside the window for the desk to hold.
//   * arms a/b are awake from 239 / 318 and never asked -- min entry drive after
//     wake 7005.6287 / 8001.7883 Pa (5.6287 / 1.7883 above threshold).
//   * the row is honest -- every unheld step with a root prints the HB section
//     integral of its own implied wall stress (Sa worst 8.500e-09 at step 241
//     over 1761 of 2000, Sb 1.968e-08 at 319 over 1682, Sc 4.255e-08 at 1481
//     over 521; W{a,b,c,d} 3.463e-09 at 181 over 1820 each). Sd offers the
//     bracket nothing (all 2000 decided states hold 1).
//   * no unheld step here implies a sub-yield stress at all -- the desk was
//     never asked to hold a moving wall.
//   * arm b's Sb is 5.59's Sa -- flags equal for all 2001 states, ladder
//     [1,318] both sides, 865/2001 rate tokens the same string, worst 6.062e-10
//     relative; Wb 1643/2001, worst 2.957e-10; Db (drain, no flag) 1536/2001,
//     worst 1.333e-11. Node Fb is 5.59's Fa within 1.000e-07 Pa (1989/2001
//     tokens identical).
//   * 12 node rows close on printed tokens alone to 4.9661e-14 m3/s = 9.93e-08
//     Pa per step; all 8 t=0 flags 0; smallest decision gap 238 steps (0.476 s)
//     over 3 gaps.

fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { fixedPressure 3.0e4; }
    B { fixedPressure 1.95e4; }

    Fa { volume 0.1; bulkModulus 1.0e8; pressure 2.7e4; }
    Fb { volume 0.1; bulkModulus 1.0e8; pressure 2.7e4; }
    Fc { volume 0.1; bulkModulus 1.0e8; pressure 2.7e4; }
    Fd { volume 0.1; bulkModulus 1.0e8; pressure 2.7e4; }
}

pipes
{
    // --- arm a: tau_0 = 1.75 (threshold 7000 Pa, release 23000 Pa) ------
    Sa { from A; to Fa; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 1.75; }
    Wa { from A; to Fa; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 1.5; }
    Da { from Fa; to B; length 20; diameter 0.02; valve 0;
         valveClose { start 0.8; end 1.0; closedK 1.0e8; }
         valveOpen  { start 2.5; end 2.7; } }

    // --- arm b: tau_0 = 2.0 (threshold 8000 Pa, release 22000 Pa) ------
    Sb { from A; to Fb; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    Wb { from A; to Fb; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 1.5; }
    Db { from Fb; to B; length 20; diameter 0.02; valve 0;
         valveClose { start 0.8; end 1.0; closedK 1.0e8; }
         valveOpen  { start 2.5; end 2.7; } }

    // --- arm c: tau_0 = 2.25 (threshold 9000 Pa, release 21000 Pa) ------
    Sc { from A; to Fc; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 2.25; }
    Wc { from A; to Fc; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 1.5; }
    Dc { from Fc; to B; length 20; diameter 0.02; valve 0;
         valveClose { start 0.8; end 1.0; closedK 1.0e8; }
         valveOpen  { start 2.5; end 2.7; } }

    // --- arm d: tau_0 = 2.5 (threshold 10000 Pa, release 20000 Pa) ------
    Sd { from A; to Fd; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 2.5; }
    Wd { from A; to Fd; length 20; diameter 0.02;
         flowIndex 0.5; consistency 1.0; yieldStress 1.5; }
    Dd { from Fd; to B; length 20; diameter 0.02; valve 0;
         valveClose { start 0.8; end 1.0; closedK 1.0e8; }
         valveOpen  { start 2.5; end 2.7; } }

}

time
{
    dt 0.002;
    endTime 4.0;
    reportEvery 1;
}
