// Same canonical plane shear as case.dict but with the WALE closure.
// For a unidirectional linear shear grad U has one component, so
// gradU^2 = 0 and Sd = 0 identically: WALE must return nut = 0 even though
// the resolved strain |S| = rate is nonzero. The checker cross-runs the
// Smagorinsky variant of this case to show a nonzero value is expected there.
block
{
    min   (0 0 0);
    max   (1 0.5 0.1);
    cells (4 8 1);

    xmin  { name left;   type symmetry; }
    xmax  { name right;  type symmetry; }
    ymin  { name bottom; type wall;     }
    ymax  { name top;    type wall;     }
    zmin  { name front;  type symmetry; }
    zmax  { name back;   type symmetry; }
}

nu 0.01;

patches
{
    left   { UType zeroGradient; p 0; pType fixedValue; }
    right  { UType zeroGradient; pType zeroGradient;    }
    bottom { U (0 0 0); UType fixedValue; pType zeroGradient; }
    top    { U (1 0 0); UType fixedValue; pType zeroGradient; }
    front  { UType zeroGradient; pType zeroGradient; }
    back   { UType zeroGradient; pType zeroGradient; }
}

schemes
{
    ddt       Euler;
    div       upwind;
    laplacian corrected;
    grad      linear;
}

les
{
    model wale;
    Cs    0.17;
    Cw    0.325;
}

profile
{
    type linearShear;
    rate 2;
}

piso
{
    dt          0.001;
    endTime     0.005;
    correctors  2;
    reportEvery 1;
}
