// 5.229 (H6) refine arm: one cycle, no diffusion (cycle 1 never diffuses).
// Bins 3,4,5 must deepen to 1 (88 cells), each child volume summing to its
// parent and each parent's two children sharing the parent's seed phi plus one
// identical uniform conservation shift (which must be round-off small).
block
{
    min  (0 0 0);
    max  (1 1 0.1);
    cells (8 8 1);
    xmin { name left;   type wall; }
    xmax { name right;  type wall; }
    ymin { name bottom; type wall; }
    ymax { name top;    type wall; }
    zmin { name front;  type symmetry; }
    zmax { name back;   type symmetry; }
}

adapt
{
    gradientThreshold 1e9;
    maxDepth 2;
    field step;
    axis x;
    interface 0.55;
    low 0.0;
    high 1.0;
    dumpCells yes;
}

amr
{
    refineThreshold  2;
    coarsenThreshold 0.5;
    cycles           1;
    every            1;
    diffusion        0.05;
    dt               0.01;
    dumpCells        yes;
}
