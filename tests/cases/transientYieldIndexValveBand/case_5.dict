// transientYieldIndexValveBand / 5: what can a calendar touch once the band is
// index-blind?
//
// 5.57 split the parking band in two: the THRESHOLD (`4 tau_0 L / d`, no `n`, no
// `K`) and the `<=` that latches on it are index-blind, so n = 0.5 / 1 / 2 all
// park in the same [22000, 28000] Pa, while everything downstream of the latch
// reads the index. That left 5.56's boundary 4 open for HB walls: a valve
// schedule is a term in the SAME row as the wall law
// (`transient.cpp:363-:382`: inertia + friction + rho*K|Q|Q/2A^2 = drive), so it
// should be able to move a rate but not a threshold. Ten arms test exactly that
// split, and they test whether the split depends on the index:
//
//   * `a` 25000 plain and `h` 25000 with BOTH rows given `valve 0` +
//     close-to-1e8 + reopen -- if a held row has no K term to read
//     (`:353-:355` replaces the row with `Q = 0` before `kv` is ever used), the
//     two must agree token for token at every index;
//   * `b` 22000 and `c` 28000 are the two band edges; `b` carries the same
//     schedule on both rows, and its waking row's drive is exactly 8000 = the
//     threshold, so the calendar must not be able to wake it;
//   * sliders: `d`/`e` start 1 Pa outside the ceiling, `j`/`f` 1 Pa outside the
//     floor, `g`/`i` 2000 Pa outside the ceiling. The second of each pair carries
//     the schedule on its WAKING row only -- and because the open value is
//     `valve 0`, the scheduled arm's row is literally the unscheduled arm's row
//     until t = 0.5 s, so the two must agree token for token right up to the step
//     the ramp starts and disagree from the next one;
//   * `e` and `f` are mirrors with the same schedule: the loss term is odd in Q
//     (`|Q|Q`), so a schedule on the high side of an UP arm and the low side of a
//     DOWN arm must still print mirrored tokens.
//
// Schedule on the armed rows: `valve 0`, `valveClose {start 0.5; end 1.0;
// closedK 1.0e8}`, `valveOpen {start 2.0; end 2.5}` -- open, closing, closed,
// reopening, open again inside one 4 s file, so the same wall law can be read
// while the row is being taxed and while it is not. Geometry and rheology are
// 5.57's: L 20, d 0.02, rho 850, mu 0.1, tau_0 2.0, and here (`flowIndex`,
// `consistency`) = (0.5, 1.0). verified by
// tests/check_transient_yield_index_valve_band.py
// (ctest verify.transientYieldIndexValveBand).
//
// measured (this file, n = 0.5): the desk and the latch never see the calendar
// -- a 25000 / 25000 / 22000 / 28000 each hold ONE token over 2001 states and
// arm h (schedule on both rows) is arm a token for token in all 2001 node and
// 2001+2001 rate tokens, because a held row becomes Q = 0 before kv is read;
// arm b is still HELD at i = 1 with drive exactly 8000 while K(t) sweeps to 1e8
// behind it, and the 20 t = 0 flags all read 0. The calendar's first byte is
// its own arithmetic: armed and unarmed rows agree through steps 0-250 (K = 0
// there) and the far slider leaves its twin on step 251, the first sample past
// closeStart -- while the 1 Pa armed arm never leaves its twin's node token in
// ANY of the 2001 states, and the reconstruction of its rate needs the
// K(t) rho|Q|Q/2A^2 term (3.757e-10 with it, 6.378e-01 relative without). The
// closed valve costs this arm 24.1797 Pa of the 167.8146 Pa of approach (14.4%)
// and throttles the rate 1.59x at t = 1.5 s, yet the wall stress the armed row
// implies is within 3.1822% of its twin's and its valve term peaks at 323.0 Pa
// = 4.0% of the 8000 Pa threshold it cannot move. After reopening, all 750
// remaining states flow FASTER than the unarmed twin (1.03..1.04x) and repay
// only 8.3% of the debt. Arms e/f mirror token for token (sum 50000 within
// 0.0e+00, 2001/2001 rates identical) and every node row closes on the printed
// tokens alone to 4.9163e-14 m3/s.

fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { fixedPressure 3.0e4; }
    B { fixedPressure 2.0e4; }

    F5a { volume 0.1; bulkModulus 1.0e8; pressure 25000.0; }
    F5h { volume 0.1; bulkModulus 1.0e8; pressure 25000.0; }
    F5b { volume 0.1; bulkModulus 1.0e8; pressure 22000.0; }
    F5c { volume 0.1; bulkModulus 1.0e8; pressure 28000.0; }

    F5d { volume 0.1; bulkModulus 1.0e8; pressure 21999.0; }
    F5e { volume 0.1; bulkModulus 1.0e8; pressure 21999.0; }
    F5j { volume 0.1; bulkModulus 1.0e8; pressure 28001.0; }
    F5f { volume 0.1; bulkModulus 1.0e8; pressure 28001.0; }
    F5g { volume 0.1; bulkModulus 1.0e8; pressure 20000.0; }
    F5i { volume 0.1; bulkModulus 1.0e8; pressure 20000.0; }
}

pipes
{
    S5a { from A; to F5a; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5a { from F5a; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }

    S5h { from A; to F5h; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E5h { from F5h; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }

    S5b { from A; to F5b; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E5b { from F5b; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }

    S5c { from A; to F5c; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5c { from F5c; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }

    S5d { from A; to F5d; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5d { from F5d; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }

    S5e { from A; to F5e; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E5e { from F5e; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }

    S5j { from A; to F5j; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5j { from F5j; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }

    S5f { from A; to F5f; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5f { from F5f; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }

    S5g { from A; to F5g; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5g { from F5g; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }

    S5i { from A; to F5i; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E5i { from F5i; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
}

time
{
    dt 0.002; endTime 4.0; reportEvery 1;
}
