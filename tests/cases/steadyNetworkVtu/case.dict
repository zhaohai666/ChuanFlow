// Steady black-oil two-phase gathering network, twin of steadyNetworkMultiphase,
// kept solely to exercise the opt-in 1D VTU dump (batch 2, item 3). The hydraulics
// are unchanged: two gas-lifted wells into a manifold, one line to a fixed-pressure
// terminal, every pipe a Beggs-Brill pipe fed by the black-oil PVT layer.
//
// `output { vtk <path>; }` is the only new key. Without it the app writes no
// file and prints byte-identical stdout; with it, one VTK_VERTEX per pipe is
// dumped at the pipe centre with x / p / T / alpha / regimeIndex (encoding
// table in steadyNetworkApp.cpp::writeSteadyNetworkVtu).
fluid
{
    blackoil
    {
        gasGravity     0.75;
        oilDensity     850;
        gor            80;    // sm3/sm3
        waterCut       0;
        temperature    340;   // K, isothermal
        surfaceTension 0.025; // N/m
    }
}

nodes
{
    W1 {};
    W2 {};
    M {};
    Outlet { pressure 4.0e6; }
}

pipes
{
    //  W1 --(climbs 60 m)--> M
    P1 { from W1; to M;    length 1200; diameter 0.08; roughness 4.6e-5; elevation 60; }
    //  W2 --(climbs 90 m)--> M
    P2 { from W2; to M;    length 1500; diameter 0.08; roughness 4.6e-5; elevation 90; }
    //  M  ------------------> terminal
    P3 { from M;  to Outlet; length 800; diameter 0.1; roughness 4.6e-5; elevation 0; }
}

sources
{
    well1 { node W1; rate 0.004; }
    well2 { node W2; rate 0.002; }
}

solve
{
    maxIter 100;
    tol     1e-10;
}

output
{
    vtk out_steady_network.vtu;
}
