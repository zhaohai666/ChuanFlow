// 5.63 起改为接受：耦合单元 + 屈服应力。屈服应力描述的是三维伙伴区里的流体，
// 不是这条一维行自己的壁面律；耦合边的损失**仍然就是**伙伴模型的陈述（5.17 起
// 的不重复计费规则），所以一维行上没有被阈值 hold 住的墙，也不会重复计费。
// checker 断言声明档与删去三个 key 的孪生档求解日志逐位相同。
// 文件名保留 `reject` 只为兼容旧拒收语义。
// verified by tests/check_steady_bingham_yield.py (ctest verify.steadyBinghamYield).
fluid { rho 850; mu 0.1; }
nodes { A { pressure 3.0e4; } B { pressure 2.0e4; } }
pipes
{
    Bad { from A; to B; length 20; diameter 0.02;
          yieldStress 1.0; coupledResistance 1.0e8; }
}
solve { maxIter 20; tol 1e-10; }
