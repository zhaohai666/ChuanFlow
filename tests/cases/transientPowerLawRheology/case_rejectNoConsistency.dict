// An index without a consistency is refused: at n != 1 the fluid's mu is not
// the same quantity as K (Pa.s^n), so silently falling back to mu would be a
// Newtonian answer wearing a rheology's name -- exactly the silent number this
// increment removes.
// verified by tests/check_transient_power_law.py (family 5).
fluid { rho 850; mu 0.1; }
nodes { A { fixedPressure 3.0e4; } B { fixedPressure 2.0e4; } }
pipes { Bad { from A; to B; length 20; diameter 0.02; flowIndex 0.6; } }
time  { dt 0.02; endTime 0.1; reportEvery 1; }
