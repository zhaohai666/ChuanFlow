// D6 increment 1: terrain-induced slugging, the low-point pooling map and its
// spill-fill initiation criterion. A sealed V-chain whose elevation polyline
// falls from the inlet (z = 0) along a gentle reach (A) and a steep drop (B)
// to the global low point at arc 35 m, then climbs (C) and rises mildly (D)
// to the outlet at z = -4.337 m. The outlet is the lower bounding crest, so
// it is the spill level: the pool spills toward it once the liquid reaches
// its elevation. The dynamic closure's per-cell gravity drive drains liquid
// downhill from both sides into the low point, so the basin (the whole chain,
// crest to crest) collects the entire sealed inventory alpha0 * L while its
// geometric spill capacity -- the arc submerged below the outlet elevation --
// is only cap ~= 25.02 m. fill = inventory / capacity = alpha0 * L / cap is
// therefore ~2 * alpha0: at alpha0 = 0.55 it is 1.10 and the dip reports
// SLUG-READY (the pool has reached its spill point); the underfilled sibling
// at alpha0 = 0.40 stays POOLING. tests/check_two_fluid.py mode terrain
// re-derives the elevation polyline, the dip, the basin and the submerged-arc
// capacity from this geometry independently, holds the printed inventory to
// the summed cell holdup and the sealed total to alpha0 * L exactly, and runs
// the underfilled / monotone / minDepth siblings.
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
}

pipes
{
    reachA { length 30; diameter 0.05; roughness 0; angleDeg -10; sections 30; }
    dropB  { length 5;  diameter 0.05; roughness 0; angleDeg -60; sections 5; }
    climbC { length 5;  diameter 0.05; roughness 0; angleDeg 60;  sections 5; }
    riseD  { length 10; diameter 0.05; roughness 0; angleDeg 5;   sections 10; }
}

closure
{
    model dynamic;
    interfacialDrag 1000;
}

initial
{
    alpha 0.55;
    water 0;
}

boundaries
{
    inlet  { type sealed; }
    outlet { type sealed; }
}

terrain
{
    minDepth 0;
}

time
{
    dt 0.01;
    endTime 60;
    reportEvery 1500;
}