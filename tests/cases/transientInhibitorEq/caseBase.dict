// O4 (5.163) twin of case.dict WITHOUT the inhibitorEquilibrium{} block:
// the plain Hammerschmidt path (kDepression 5 on c = 0.3). The checker
// witnesses that this run reports no Teq/dTsub columns at all and that the
// disabled twin (enable false) is byte-identical to it.
fluid
{
    rhoL 1000;
    rhoG 200;
    muL  0.01;
    muG  1e-5;
    cL   4180;
    cG   2150;
    gasR 287;
}

pipe
{
    length 20;
    diameter 0.02;
    angleDeg 30;
    roughness 0;
    sections 10;
}

closure
{
    model wallis;
    slipVelocity 0;
}

initial
{
    alpha 0.5;
    water 0.5;
    temperature 300;
}

boundaries
{
    inlet  { type sealed; }
    outlet { type sealed; }
}

thermal
{
    wallHeatTransfer 50;
    wallModel geothermal;
    surfaceTemperature 172.6;
    gradient 1.2;
    inletDepth 100;
}

hydrate
{
    curveA 35.2;
    curveB -5684;
    growthRate 0.01;
    dissociationRate 0.01;
    gasContent 122;
    latentHeat 4.2e8;
    initial 0.04;
}

inhibitor
{
    kDepression 5;
    initial 0.3;
}

time
{
    dt 0.5;
    endTime 400;
    reportEvery 40;
}
