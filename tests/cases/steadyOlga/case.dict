// 5.155 (G4 family): the steadyNetworkMultiphase anchor with the declared
// alternative holdup law `correlation olgasSteady;` on every marched pipe -
// the same geometry, the same two wells, the same rates and the same
// fixed-pressure terminal, so the ONLY difference from the shipped path is
// the holdup law. tests/check_steady_olgas.py re-derives the whole march
// independently from this dictionary, twin-compares the dp/HL move against
// the Beggs-Brill runs, and asserts the flow-pattern map L1..L4 / oRegime
// stay the map's own verdict.
fluid
{
    blackoil
    {
        gasGravity     0.75;
        oilDensity     850;
        gor            80;    // sm3/sm3
        waterCut       0;
        temperature    340;   // K, isothermal
        surfaceTension 0.025; // N/m
    }
}

nodes
{
    W1 {};
    W2 {};
    M {};
    Outlet { pressure 4.0e6; }
}

pipes
{
    //  W1 --(climbs 60 m)--> M
    P1 { from W1; to M;    length 1200; diameter 0.08; roughness 4.6e-5; elevation 60; correlation olgasSteady; }
    //  W2 --(climbs 90 m)--> M
    P2 { from W2; to M;    length 1500; diameter 0.08; roughness 4.6e-5; elevation 90; correlation olgasSteady; }
    //  M  ------------------> terminal
    P3 { from M;  to Outlet; length 800; diameter 0.1; roughness 4.6e-5; elevation 0; correlation olgasSteady; }
}

sources
{
    well1 { node W1; rate 0.004; }
    well2 { node W2; rate 0.002; }
}

solve
{
    maxIter 100;
    tol     1e-10;
}
