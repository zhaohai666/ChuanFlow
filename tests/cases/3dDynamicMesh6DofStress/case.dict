// 5.236 (H6): fluid-stress loaded 6DOF body. The block boundary is a closed
// box (V = 1 x 0.1 x 0.1 = 0.01 m3) translating rigidly with U_mesh = (0.5,0,0)
// while the hydrostatic closure p = pressureRef + rho g.x, g = (0,0,-9.81),
// loads it. The net pressure force is exactly the buoyancy -rho g V =
// (0,0,98.1) N, the net moment is r_c(t) x Fp about the origin, the viscous
// force is zero (no velocity gradient declared) and the integrated load
// REPLACES bodyForce / drag in the body advance, so x = v = 0 while the
// rotational DOF keeps its damped oscillation (moment.z = 0). The mesh, the
// GCL-corrected transport and the scalar stay identical to the F11 reference.
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (20 1 1);
    xmin  { name left;   type wall;     }
    xmax  { name right;  type wall;     }
    ymin  { name bottom; type symmetry; }
    ymax  { name top;    type symmetry; }
    zmin  { name front;  type empty;    }
    zmax  { name back;   type empty;    }
}

dynamicMesh
{
    meshVelocity  (0.5 0 0);
    fluidVelocity (0 0 0);
    bodyForce     (10 0 0);
    mass          2;
    drag          1;
    inertia       0.5;
    rotDrag       0.1;
    rotStiffness  4;
    theta0        0.1;
    omega0        0;
    initialValue  7;
    dt            0.01;
    steps         200;
    reportEvery   1;
}

fluidStress
{
    density     1000;
    viscosity   1.0;
    gravity     (0 0 -9.81);
    pressureRef 0;
}
