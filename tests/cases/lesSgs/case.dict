// LES Smagorinsky on a canonical plane shear, U = (rate*y, 0, 0).
// The initial field is set by the analytic `profile`, so at t=0 the resolved
// strain is uniform, |S| = rate, and nut = (Cs*Delta)^2*rate with Delta=V^(1/3).
// Top/bottom walls carry the exact linear-profile values, so the Gauss gradient
// of the seeded field is exact in every cell (including boundary cells).
block
{
    min   (0 0 0);
    max   (1 0.5 0.1);
    cells (4 8 1);

    xmin  { name left;   type symmetry; }
    xmax  { name right;  type symmetry; }
    ymin  { name bottom; type wall;     }
    ymax  { name top;    type wall;     }
    zmin  { name front;  type symmetry; }
    zmax  { name back;   type symmetry; }
}

nu 0.01;

patches
{
    left   { UType zeroGradient; p 0; pType fixedValue; }
    right  { UType zeroGradient; pType zeroGradient;    }
    bottom { U (0 0 0); UType fixedValue; pType zeroGradient; }
    top    { U (1 0 0); UType fixedValue; pType zeroGradient; } // rate*H = 2*0.5
    front  { UType zeroGradient; pType zeroGradient; }
    back   { UType zeroGradient; pType zeroGradient; }
}

schemes
{
    ddt       Euler;
    div       upwind;
    laplacian corrected;
    grad      linear;
}

les
{
    model smagorinsky;
    Cs    0.17;
}

profile
{
    type linearShear;
    rate 2;
}

piso
{
    dt          0.001;
    endTime     0.005;
    correctors  2;
    reportEvery 1;
}
