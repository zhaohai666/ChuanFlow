// A plane interface carried across the domain by a uniform velocity.
//
// The velocity is prescribed, not solved: a constant U is linear in the
// coordinates, so the discrete flux divergence sum_f U(x_f).Sf of every cell is
// the integral of div(U) over it and is exactly zero -- the transport therefore
// has to be conservative and bounded by construction, which is what
// tests/check_vof.py measures. The inlet feeds alpha = 1, the phase fraction the
// region behind the interface already holds, so phase 1 enters at exactly U *
// inlet area; the outflow carries what the interface has been smeared into, so
// the balance is a closed-form statement rather than a number to be stored.
//
// Verified by tests/check_vof.py (ctest verify.vofTranslation):
//   max |div(phi)|                0 exactly (684 faces, 160 cells)
//   mass balance                  the inlet feeds U*A*t = 0.002 and the field
//                                 gains 0.00199999973: the 2.7e-10 short is the
//                                 outflow, which carries the upwind tail the
//                                 interface leaves in the dry region (alpha 1.2e-6
//                                 at the outlet, and U*A*t*alpha bounds the
//                                 deficit by 2.4e-9). It is signed and bounded,
//                                 not zero.
//   alpha                         within [0,1] to round-off, no clipping (min 1.2e-6
//                                 is exactly that exponential tail, 1/3^k ahead of
//                                 the front at U dt/dx = 0.5)
//   the 0.5 crossing              0.9986 * U, 0.0083 m behind x0 + U*t (= 0.33 dx)
//   across the 4 rows of y        differ by at most 1.0e-16, one ulp of alpha = 1:
//                                 the interface is y-invariant, and the iterative
//                                 solver's sweep order is why it is not the last bit
//   kappa = div(nhat)             0 to 1e-11: a plane has no curvature
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (40 4 1);

    xmin  { name inlet;   type inlet;    }
    xmax  { name outlet;  type outlet;   }
    ymin  { name bottom;  type wall;     }
    ymax  { name top;     type wall;     }
    zmin  { name front;   type symmetry; }
    zmax  { name back;    type symmetry; }
}

velocity
{
    type uniform;
    U    (1 0 0);
}

// cell-filled, as a sharp VOF initialisation is: phase 1 on the negative side
// of the plane through x = 0.2 with normal +x.
alpha
{
    plane { point (0.2 0.05 0.05); normal (1 0 0); }
}

patches
{
    inlet  { alphaType fixedValue; alpha 1; }
    outlet { alphaType zeroGradient;        }
    bottom { alphaType zeroGradient;        }
    top    { alphaType zeroGradient;        }
}

time
{
    dt          0.0125;   // U dt / dx = 0.5
    endTime     0.2;      // the interface travels 0.2 m: 0.2 -> 0.4
    reportEvery 4;
}

schemes
{
    ddt  Euler;
    div  upwind;
    grad corrected;
}

solverTol 1e-13;

output
{
    vtk         out_vof_translation.vtu;
    vtkInitial  initial_vof_translation.vtu;
}
