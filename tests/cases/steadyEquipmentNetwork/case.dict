// Both equipment types in one network: a rate-fed line runs through a valve
// into a free junction, then a pump lifts it over a 10 m hill to a fixed
// terminal. With the source rate imposed, every rate is known and the free
// node pressures follow from the closed-form chain
//   p_J1   = p_out + rho g dz + dpFriction(P2) - rho g H(q)
//   p_W1   = p_J1 + dpFriction(P1) + dpValve(P1),
// which the checker recomputes from Churchill's laminar limit. The pump
// almost balances the lift here (p_J1 lands below the terminal pressure):
// exactly the regime where a wrong pump-head sign would flip the junction
// pressure by ~4 bar, so the case is also a sign test.
//
// Measured (rho 850, mu 0.1, q = 3e-4 = q1, Re = 64.9):
//   p_J1 = 72750 Pa, p_W1 = 173511 Pa
//   H(q) = 25 m exactly, dpPump(P2) = -2.08391e5 Pa vs lift 83357 Pa
// verified by tests/check_steady_equipment.py
// (ctest verify.steadyEquipmentNetwork).
fluid
{
    rho 850; mu 0.1;
}

nodes
{
    W1 {}
    J1 {}
    Outlet { pressure 1.0e5; }
}

pipes
{
    P1 { from W1; to J1; length 500; diameter 0.05; roughness 0; valve 300; }
    P2 { from J1; to Outlet; length 500; diameter 0.05; roughness 0;
         elevation 10; pumpHead 25; pumpRate 3.0e-4; pumpShutoffHead 40; }
}

sources
{
    s1 { node W1; rate 3.0e-4; }
}

solve { maxIter 100; tol 1e-12; }
