// steadyPowerLawRheology control 2 (5.63): a coupled element that also declares
// a rheology is now ACCEPTED. The declaration describes the fluid inside the 3D
// partner region, not a wall law for this 1D row; the row still charges only
// R*q (5.43), so no wall is charged twice. The checker asserts that the 1D
// trace is bit-identical to a twin case with the three keys removed. The name
// keeps `reject` only for historical continuity with the earlier refusal.
fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { pressure 3.0e4; }
    B { pressure 2.0e4; }
}

pipes
{
    Bad { from A; to B; length 20; diameter 0.02;
          coupledResistance 1.0e6;
          flowIndex 0.5; consistency 1.0; }
