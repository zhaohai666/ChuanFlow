// 5.160 (P21): the diameter-optimization case. The base network is the
// byte-identity twin diameterBase.dict plus this one top-level block. P1 and
// P2 are strictly symmetric (same length, elevation, roughness, equal
// wellhead pressures), so (0.05, 0.06) and (0.06, 0.05) tie exactly on the
// total-drop objective and the declared maxPressure at the manifold excludes
// every fatter pair: the tie must resolve to the earlier-enumerated
// combination (pipe 0 is the slowest digit). The checker re-runs every
// combination through the solver itself and re-picks the ranking; see
// tests/check_steady_optimize.py.
fluid
{
    rho 850;
    mu  0.1;
}

nodes
{
    W1 { pressure 2.0e6; }
    W2 { pressure 2.0e6; }
    M {};
    Outlet { pressure 1.0e6; }
}

pipes
{
    P1 { from W1; to M; length 1200; diameter 0.05; roughness 0; elevation 6; }
    P2 { from W2; to M; length 1200; diameter 0.05; roughness 0; elevation 6; }
    P3 { from M;  to Outlet; length 900; diameter 0.05; roughness 0; elevation 0; }
}

// a small manifold draw keeps the relative residual scale non-zero and,
// injected at M itself, leaves the P1/P2 mirror symmetry exact
sources
{
    draw { node M; rate 1.0e-5; }
}

solve
{
    maxIter 100;
    tol     1e-12;
}

diameterOptimization
{
    pipes ( P1 P2 );
    candidates ( 0.05 0.06 0.075 );
    objective minTotalDp;
    objectiveSense min;
    maxCombinations 64;
    reportTop 3;
    costPerMeter 500;
    constraints
    {
        mLimit { node M; maxPressure 1.69e6; }
    }
}
