// P10 (5.156): the separator and the compressor as 1D steady point elements.
// The checker re-derives every number from the case text alone: the flash
// allocation through the shipped Standing/VB/DAK restatement, the component
// mass balance with entrainment, and both compressor modes' closed forms.
separators
{
    // Ideal single-stage split of a live oil with 10% water: the condensables
    // all leave through the liquid outlet and only the liberated gas goes to
    // the flare line.
    SEP_IDEAL
    {
        feedRate 2.0e-3;
        pressure 5.0e5;
        temperature 320.0;
        fluid
        {
            blackoil
            {
                gasGravity 0.75;
                oilDensity 850.0;
                gor 100.0;
                waterCut 0.1;
                waterDensity 1000.0;
            }
        }
    }
    // The same feed through a machine that recovers 90% of the condensables
    // and drops 10 kPa across its internals: the entrained tenth shows up on
    // the gas outlet, and both outlets sit at the stage pressure minus dP.
    SEP_ENTRAIN
    {
        feedRate 2.0e-3;
        pressure 5.0e5;
        temperature 320.0;
        efficiency 0.9;
        dP 1.0e4;
        fluid
        {
            blackoil
            {
                gasGravity 0.75;
                oilDensity 850.0;
                gor 100.0;
                waterCut 0.1;
                waterDensity 1000.0;
            }
        }
    }
    // Dead oil at atmospheric stage: nothing liberates, the gas outlet carries
    // only entrainment, and the liquid outlet is oil plus water.
    SEP_DEAD
    {
        feedRate 1.0e-3;
        pressure 1.0e5;
        temperature 300.0;
        fluid
        {
            blackoil
            {
                gasGravity 0.75;
                oilDensity 850.0;
                gor 0.0;
                waterCut 0.0;
                waterDensity 1000.0;
            }
        }
    }
    // A second fluid at a higher stage: the flash moves, the allocation
    // arithmetic must move with it.
    SEP_HOT
    {
        feedRate 5.0e-4;
        pressure 1.0e6;
        temperature 350.0;
        efficiency 0.95;
        dP 2.0e4;
        fluid
        {
            blackoil
            {
                gasGravity 0.6;
                oilDensity 820.0;
                gor 200.0;
                waterCut 0.3;
                waterDensity 1020.0;
            }
        }
    }
}

compressors
{
    // Head mode at perfect efficiency: the shaft power IS the closed anchor
    // W = m Z R_spec T1 (k/(k-1)) (PR^((k-1)/k) - 1) and T2 is isentropic.
    CMP_HEAD_IDEAL
    {
        polytropicHead 1.0e5;
        polytropicEfficiency 1.0;
        kappa 1.3;
        specificGasConstant 518.28;
        compressibility 0.95;
        suctionPressure 5.0e6;
        suctionTemperature 300.0;
        rate 0.05;
    }
    // The same machine at 90% efficiency: same ratio (the head is declared,
    // not derived from eta), more shaft power, hotter discharge.
    CMP_HEAD_LOSS
    {
        polytropicHead 1.0e5;
        polytropicEfficiency 0.9;
        kappa 1.3;
        specificGasConstant 518.28;
        compressibility 0.95;
        suctionPressure 5.0e6;
        suctionTemperature 300.0;
        rate 0.05;
    }
    // Curve mode read AT the rated point: the ratio is exactly the catalog
    // pressureRatio.
    CMP_CURVE_RATED
    {
        pressureRatio 2.0;
        shutoffRatio 2.4;
        ratedRate 0.04;
        polytropicEfficiency 0.9;
        kappa 1.3;
        specificGasConstant 518.28;
        compressibility 0.95;
        suctionPressure 5.0e6;
        suctionTemperature 300.0;
        rate 0.04;
    }
    // The same curve at half the rated rate: PR = 2.4 - 0.4 * 0.25 = 2.3.
    CMP_CURVE_HALF
    {
        pressureRatio 2.0;
        shutoffRatio 2.4;
        ratedRate 0.04;
        polytropicEfficiency 0.9;
        kappa 1.3;
        specificGasConstant 518.28;
        compressibility 0.95;
        suctionPressure 5.0e6;
        suctionTemperature 300.0;
        rate 0.02;
    }
}
