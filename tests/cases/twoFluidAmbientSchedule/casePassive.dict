// 5.230 (F-class) passive twin: the schedule arm with ambientSchedule{}
// NOT declared - the 5.144 constant-wall relax case verbatim in its physics
// blocks. The wall stays 280 K, no wallT column prints, and the temperature
// field follows the old closed-form relaxation (the checker also runs the
// 5.144 deck itself as the byte witness).
fluid
{
    rhoL 1000; rhoG 20; muL 0.01; muG 1e-5;
    cL 4180; cG 2150;
}

pipe
{
    length 10; diameter 0.02; roughness 0; angleDeg 0; sections 20;
}

closure
{
    model wallis; slipVelocity 0;
}

initial
{
    alpha 1; temperature 320;
}

boundaries
{
    inlet { type sealed; }
    outlet { type sealed; }
}

thermal
{
    wallHeatTransfer 2;
    wallModel constant;
    wallTemperature 280;
}

time { dt 2; endTime 60; reportEvery 1; }
