// dpmChannel: one-way Lagrangian spheres in a solved laminar duct.
// The carrier is a 1 m x 0.2 m planar channel (nu 1e-5, inlet U = 0.1 m/s).
// Two streams: stream0 relaxes from rest toward the carrier and leaves at the
// outlet; stream1 is launched near the bottom wall with a downward velocity
// and impacts it. Particles only sample U, never write momentum back.
block
{
    min   (0 0 0);
    max   (1 0.2 0.1);
    cells (50 20 1);

    xmin  { name inlet;   type inlet;    }
    xmax  { name outlet;  type outlet;   }
    ymin  { name bottom;  type wall;     }
    ymax  { name top;     type wall;     }
    zmin  { name front;   type symmetry; }
    zmax  { name back;    type symmetry; }
}

nu 1e-5;

patches
{
    inlet  { U (0.1 0 0); UType fixedValue;  pType zeroGradient; }
    outlet { UType zeroGradient; p 0;        pType fixedValue;   }
    bottom { U (0 0 0);   UType fixedValue;  pType zeroGradient; }
    top    { U (0 0 0);   UType fixedValue;  pType zeroGradient; }
}

initial { U (0.1 0 0); }

schemes
{
    ddt       steady;
    div       upwind;
    laplacian corrected;
    grad      corrected;
}

simple
{
    maxIterations 300;
    continuityTol 1e-6;
    pcorrTol      1e-4;
    momentumTol   1e-4;
    relaxU        0.9;
    relaxP        0.03;
    pRelaxStart   0.02;
}

dpm
{
    dt 0.0001;
    maxSteps 120000;
    carrierRho 1000;
    gravity (0 -9.81 0);
    drag schillerNaumann;
    reportEvery 10000;
    traceId 0;
    traceSteps 4;

    // 1 mm glass-like spheres, rho_p = 2500 kg/m3. The initial particle
    // Reynolds number is ~10, so the full Schiller-Naumann branch is used.
    stream0 {
        point (0.05 0.15 0.05);
        velocity (0 0 0);
        diameter 1e-3;
        density 2500;
        count 1;
    }
    stream1 {
        point (0.05 0.02 0.05);
        velocity (0 -0.5 0);
        diameter 3e-3;
        density 8000;
        count 1;
    }
}

output
{
    vtk out_dpm_channel.vtu;
}
