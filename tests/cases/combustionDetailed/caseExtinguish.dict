// F10 extinction case: the termination pre-exponential A2 is raised so that
// A2 exp(-E2/RT0) > A1 exp(-E1/RT0) Yf0 (branchDa < 1). The radical seed then
// decays monotonically, there is no thermal runaway, and the reactor sits at
// T0. The checker asserts Yr strictly decreases and T never approaches the
// ignition threshold. Integrated to 20 s so the decay is unambiguous.
detailedChemistry
{
    A1 2000;
    E1 60000;
    A2 200;
    E2 30000;
    q 800;
    T0 1200;
    gasConstant 8.314462618;
    Yf0 1;
    Yr0 1e-4;
    cooling 0;
    Tenv 1200;
    dt 0.01;
    nSteps 2000;
    nSub 10;
    ignitionRise 0.3;
    tIgnMax 4;
}
