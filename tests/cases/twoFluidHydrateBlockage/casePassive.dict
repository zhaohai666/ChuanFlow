// 5.227 (F-class) passive twin: the deposition arm with blockage{} NOT
// declared. The 5.186 non-blocking path must run untouched: no dEff/blk
// column, and the hydraulics identical to the declared arm with the blockage
// made inert. The physics blocks mirror the 5.186 case's hydrate kinetics
// (the checker also runs the 5.186 deck itself as the byte witness).
fluid { rhoL 900; rhoG 15; muL 0.002; muG 1.2e-5; cL 2000; cG 2100; gasR 470; }

pipe { length 200; diameter 0.1; roughness 1.0e-4; angleDeg 0; sections 20; }

closure { model wallis; slipVelocity 0.2; }

initial { alpha 0.2; water 0.1; temperature 300; }

boundaries
{
    inlet  { type phaseRates; vsl 3.0; vsg 5.0; waterFraction 0.1;
             temperature 300; }
    outlet { type fixedPressure; p 5.0e6; temperature 300; }
}

thermal { wallHeatTransfer 50; wallModel constant; wallTemperature 300; }

hydrate
{
    curveA 33.0;
    curveB -5684;
    growthRate 0.01;
    dissociationRate 0.05;
    gasContent 122;
    latentHeat 4.2e8;
    initial 0.1;
}

time { dt 0.05; endTime 20; reportEvery 1; }
