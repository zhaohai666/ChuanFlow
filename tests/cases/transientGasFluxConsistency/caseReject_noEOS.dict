// Gas-flux consistency Wood arm (E7c acoustic extension): a sealed,
// quiescent 50/50 line venting from a uniform acoustic overpressure -
// the same depressurization scenario as the E7c case, but the wave
// speed is Wood's homogeneous-mixture sound speed
//   1 / (rho_m a^2) = alphaL / (rhoL aL^2) + alphaG / (rhoG aG^2),
// aG^2 = gasR T the EOS-exact gas derivative, aL the DECLARED liquid
// sound speed 1200 m/s. With rhoL >> rhoG the liquid compliance term
// dominates: a_wood ~ 62.8 m/s - five times SLOWER than the EOS gas
// speed 293.4 m/s, the textbook mixture-compressibility collapse (bubbles
// make the line acoustically soft). The checker re-derives a_wood from
// the case text alone, verifies the reported fronts ride it (and NOT the
// EOS speed), that the reflection period moves to 4L/a_wood, and that
// the undeclared twin (caseWoodBase, the default aModel eos path) rides
// the EOS speed and stays byte-identical to the pre-fix baseline.

fluid
{
    rhoL 1000;
    rhoG 11.61;      // p0 = 999621 Pa; rhoG aG^2 = rhoG gasR T = p0
    muL  0.01;
    muG  1e-5;

}

pipe
{
    length 100;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 100;
}

closure
{
    model wallis;
}

initial
{
    alpha 0.5;       // a 50/50 mixture: Wood's equation bites here (the
                     // liquid compliance dominates the gas compliance
                     // and the mixture speed collapses to ~63 m/s)
    water 0;
    temperature 300;
}

boundaries
{
    inlet { type sealed; }
    outlet { type sealed; }
}

acoustics
{
    enable true;
    initialGauge 1e6;
    aModel wood;
    liquidSoundSpeed 1200;
    cfl 0.5;
    openEnd outlet;
}

time
{
    dt 0.001;        // a_wood dt / dx ~ 0.063 << 0.5
    endTime 10;      // covers the 4L/a ~ 6.4 s quarter-wave period
    reportEvery 5;
}
