// E6 (5.176): reduced 1D pig (scraper) tracking on a horizontal bore.
// The pig is a Lagrangian point that rides beside the two-fluid holdup field.
// It launches at x=0 with the declared base velocity u0=2 m/s, piles a
// fraction (pushEfficiency) of the liquid it sweeps into a front inventory
// `holdupFront`, and slows as that front grows (v = u0 (1 - beta H/C)).
// A liquid pulse (vsl 0.8 in [3,7) s) makes the swept alpha vary in space so
// the front pile is genuinely position-dependent. At x=20 (ARRIVE) the whole
// piled front is released as `out` and the pig freezes.
//
// This is a DECLARED reduced kinematic law -- no bypass flow, no seal failure,
// no bend resistance; the pig does not write back to the holdup field. The
// undeclared twin (caseBase.dict) and enable-false twin (caseDisabled.dict)
// are byte-identical once the pig lines are stripped.
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
}

pipe
{
    length 20;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 20;
}

closure
{
    model wallis;
    slipVelocity 0.5;
}

initial
{
    alpha 0.61803398875;
    water 0.3;
}

pigging
{
    enable true;
    startX 0;
    endX 20;
    pigVelocity 2.0;
    blockage 0.5;
    pushEfficiency 0.6;
    frontCapacity 8;
}

boundaries
{
    inlet
    {
        type phaseRates;
        vsl 0.5;
        vsg 0.5;
        waterFraction 0.3;
        schedule
        {
            p1 { t 3; vsl 0.8; vsg 0.2; }
            p2 { t 7; vsl 0.5; vsg 0.5; }
        }
    }
    outlet { type fixedPressure; p 5e6; }
}

time
{
    dt 0.05;
    endTime 20;
    reportEvery 1;
}
