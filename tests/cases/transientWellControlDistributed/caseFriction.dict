// 5.226 arm 2: steady single-phase annular friction, distributed per segment.
//
// The column carries no gas (single phase, rhoM = rhoL) and is fed by the
// 5.185 reservoir's own PI law re-used against the annulus bottom pressure
// (keep both: the reservoir still feeds node BH exactly as §5.185 does):
//     q = J (p_res - p_bottom) = 5e-9 * 2e6 = 0.01 m3/s, constant.
// The BOP never closes in the run (closeTime 1000 > endTime), so kv = openKv
// on every frame and the outflow law q = kv sqrt(pTop - pSurface) prices the
// ram drop exactly. Each cell's reported dpf must equal the closed-form
// Darcy-Weisbach number f rhoM |vM| vM L / (2 De) with f from the same
// Churchill blend the steady kernel reads (roughness 1e-4, De = 0.2).
fluid { rho 1200; mu 0.05; }

nodes
{
    BH   { volume 50; bulkModulus 2.0e9; pressure 3.7e7; liquidFraction 0.8; }
    SURF { fixedPressure 1.0e5; }
}

pipes
{
    WELL { from BH; to SURF; length 3000; diameter 0.25; roughness 1.0e-4;
           elevation 3000; valve 20;
           valveClose { start 0; end 0; closedK 1.0e12; } }
}

reservoir
{
    RES { node BH; pressure 4.2e7; productivityIndex 5.0e-9;
          gasFraction 0; depth 3000; }
}

annulus
{
    ANN
    {
        reservoir RES;
        bottomPressure 4.0e7;
        gasDensity 30;
        surfacePressure 1.0e5;
        temperature 300;
        segments
        {
            S1 { innerD 0.2; outerD 0.4; length 50; roughness 1.0e-4; }
            S2 { innerD 0.2; outerD 0.4; length 50; roughness 1.0e-4; }
            S3 { innerD 0.2; outerD 0.4; length 50; roughness 1.0e-4; }
            S4 { innerD 0.2; outerD 0.4; length 50; roughness 1.0e-4; }
        }
    }
}

bop
{
    B1 { annulus ANN; closeTime 1000; openKv 0.002; closedKv 0; }
}

time { dt 0.2; endTime 10; reportEvery 1; }
