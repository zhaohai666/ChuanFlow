// O2 (5.161) byte-identity witness: the case.dict timeline without the
// slugTracking block. The run must be byte-for-byte identical to the
// declared run's physics (the checker diffs the two full reports).
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
}

pipe
{
    length 20;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 20;
}

closure
{
    model wallis;
    slipVelocity 0.5;
}

initial
{
    alpha 0.17082039325003;
    water 0.3;
}

slug
{
    alphaThreshold 0.45;
    minLength 0.5;
}

boundaries
{
    inlet
    {
        type phaseRates;
        vsl 0.1;
        vsg 0.9;
        waterFraction 0.3;
        schedule
        {
            p1 { t 5;  vsl 0.75; vsg 0.25; }
            p2 { t 10; vsl 0.1;  vsg 0.9; }
            p3 { t 12; vsl 0.75; vsg 0.25; }
            p4 { t 17; vsl 0.1;  vsg  0.9; }
        }
    }
    outlet { type fixedPressure; p 5e6; }
}

time
{
    dt 0.05;
    endTime 60;
    reportEvery 1;
}
