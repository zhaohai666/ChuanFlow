// 5.228 (H6) rejection fixture: the named surface (left) is a single open
// patch, so the area-vector sum does not vanish and the integrated load must
// be refused loudly instead of silently reporting a half-box force.
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (20 1 1);
    xmin  { name left;   type wall;     }
    xmax  { name right;  type wall;     }
    ymin  { name bottom; type symmetry; }
    ymax  { name top;    type symmetry; }
    zmin  { name front;  type empty;    }
    zmax  { name back;   type empty;    }
}

dynamicMesh
{
    meshVelocity  (0.5 0 0);
    fluidVelocity (0 0 0);
    bodyForce     (10 0 0);
    mass          2;
    drag          1;
    inertia       0.5;
    rotDrag       0.1;
    rotStiffness  4;
    theta0        0.1;
    omega0        0;
    initialValue  7;
    dt            0.01;
    steps         200;
    reportEvery   1;
}

fluidStress
{
    density     1000;
    viscosity   1.0;
    gravity     (0 0 -9.81);
    pressureRef 0;
    surface     (left);
}
