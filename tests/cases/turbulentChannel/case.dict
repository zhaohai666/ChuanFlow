// Fully developed turbulent plane channel at a known wall shear stress.
//
// The channel is driven by a uniform body force across a domain that is
// invariant in x, so the flow is a single column: the wall shear balances the
// force exactly and tau_w = u_tau^2 = force * H/2 is an *input* of the case.
// What the turbulence model has to predict is then the bulk velocity that this
// shear can sustain -- the classic friction-law test:
//
//   force = 19.5 m/s^2, H = 0.04 m, nu = 1.5e-5
//   u_tau = sqrt(19.5 * 0.02) = 0.6245 m/s, Re_tau = u_tau H / (2 nu) = 833
//   Pope's smooth-wall law 1/sqrt(f) = 2 log10(Re_b sqrt(f)) - 0.6 with
//   u_tau/U_b = sqrt(f/8) gives U_b = 13.0 m/s, Re_b = 6.9e4.
//
// dy = 2.5e-3 puts the first cell centre at y+ ~ 52, inside the log layer where
// the wall function belongs. Both couplings are regression-tested on this case:
// the transient is advanced to endTime 8 (2000 steps), by which time the heat
// balance has gone quasi-steady (the residual below is the storage rate), and
// steady SIMPLE reaches the same balance in a few dozen outer iterations --
// which it can only do because momentumTol gates the stop,
// since on a streamwise-uniform column every phi is zero and continuity reads 0
// on the first iteration.
//
// Measured (Ub from the vtu centroids, Pope's law gives 12.98 m/s):
//                 u_tau    Ub      Ub/u_tau    iterations
//   piso  kEpsilon  0.6245   11.10   17.8       2000 steps    (-14.5%)
//   piso  kOmegaSST 0.6245   13.68   21.9       2000 steps    ( +5.4%)
//   simple kEpsilon 0.6245   10.96   17.6        27          (-15.5%)
//   simple kOmegaSST0.6245   13.78   22.1        39          ( +6.2%)
// The shear itself is right to 4e-4 relative in every run, because it is the
// balance and not a prediction; the deficit is the friction law read on a mesh
// that resolves the log layer with eight cells. The checker therefore bounds the
// bulk velocity at 20% and checks the near-wall closure tightly.
//
// tests/check_turbulent_channel.py runs this case for both models and both
// couplings and checks the wall shear against the driving force, the first cell
// against the law of the wall, the bulk velocity against Pope's friction law,
// the equilibrium of the wall-adjacent cell, that the run is steady, symmetric
// and finite, and that the heat the turbulence releases leaves through the
// walls (assertion 8 below).
//
// The energy block makes the column carry the heat the turbulence releases:
// turbulentDissipation switches the eps/cp source into the energy equation,
// rho = cp = 1 keeps the bookkeeping kinematic, and Pr = nu/alpha = 1 sits
// inside the thermal wall function's band. The 300 K walls are the only exit
// for the generated heat, so the discrete balance closes with the wall flux
// carrying exactly the generated heat; measured balance (in + source
// - enthalpyOut) 8.7e-16 / 2.6e-16 W for SIMPLE and 2.9e-9 / 1.1e-7 W for
// PISO at endTime 8 (the transient is still storing a little heat), and the
// volume integral of eps over the vtu equals the reported source to 1e-8
// relative. The wall-adjacent cell is held at the log-layer pair, so its
// eps = u_tau^3/(kappa y1) = 475.23 in every run of both models (for SST read
// through eps = betaStar k omega).
//
// The thermodynamic identity source = pump power (force * Ub * V) is only a
// visibility band here, not an equality: the wall-function closure holds the
// wall cells algebraically at the log-layer pair, which is not
// energy-conservative. Measured source/pump 0.76..1.18 over the four runs;
// dropping the eps source entirely reads 0.004 (kEpsilon) to 0.03 (SST),
// far below the band the checker asserts -- so the check still sees a
// missing or a doubled source.
block
{
    min   (0 0 0);
    max   (0.02 0.04 0.02);
    cells (1 16 1);

    xmin  { name left;   type symmetry; }
    xmax  { name right;  type symmetry; }
    ymin  { name bottom; type wall;     }
    ymax  { name top;    type wall;     }
    zmin  { name front;  type symmetry; }
    zmax  { name back;   type symmetry; }
}

nu 1.5e-5;

// A started velocity: the law-of-the-wall closure only has something to say
// once the near-wall cells carry a log-layer speed, and it also sets the
// turbulence scale through the reference velocity of the model.
initial
{
    U (8 0 0);
}

patches
{
    // x-invariant flow: zero normal gradient on both ends, one pressure anchor
    left  { UType zeroGradient; p 0; pType fixedValue; }
    right { UType zeroGradient; pType zeroGradient;    }
    bottom{ U (0 0 0); UType fixedValue; pType zeroGradient; T 300; }
    top   { U (0 0 0); UType fixedValue; pType zeroGradient; T 300; }
}

energy
{
    rho 1;
    cp 1;
    kappa 1.5e-5;
    turbulentDissipation true;
    initialT 300;
    relaxation 1;
}

turbulence
{
    model       kEpsilon;   // the checker rewrites this for kOmegaSST
    intensity   0.05;
    lengthScale 0.0056;     // 7% of D_h
    relaxation  0.7;
}

schemes
{
    ddt       Euler;
    div       upwind;
    laplacian corrected;
    grad      corrected;
}

simple
{
    // The column is streamwise-uniform, so every phi is zero and continuity is
    // satisfied at machine precision from the first iteration. momentumTol is
    // the criterion that actually decides the run: it is the relative change of
    // the velocity over one outer iteration, and it is what keeps SIMPLE from
    // stopping before the wall shear has been felt.
    maxIterations 200;
    continuityTol 1e-8;
    momentumTol   1e-5;
    relaxU        0.9;
    relaxP        0.8;
    force         (19.5 0 0);
}

piso
{
    // nu_eff*dt/dy^2 = 3.3e-4*4e-3/6.25e-6 = 0.21: inside the diffusion-number
    // limit documented in PisoSolver.h
    dt            0.004;
    endTime       8;
    correctors    2;
    continuityTol 1e-8;
    reportEvery   250;
    force         (19.5 0 0);
}

output
{
    vtk out_turbulent_channel.vtu;
}
