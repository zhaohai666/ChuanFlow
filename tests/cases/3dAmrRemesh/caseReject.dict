// 5.237 (H6) rejection fixture: a coarsen threshold at or above the refine
// threshold would make every indicator both a refine and a coarsen candidate;
// the loop must refuse it loudly instead of oscillating.
block
{
    min  (0 0 0);
    max  (1 1 0.1);
    cells (8 8 1);
    xmin { name left;   type wall; }
    xmax { name right;  type wall; }
    ymin { name bottom; type wall; }
    ymax { name top;    type wall; }
    zmin { name front;  type symmetry; }
    zmax { name back;   type symmetry; }
}

adapt
{
    gradientThreshold 1e9;
    maxDepth 2;
    field step;
    axis x;
    interface 0.55;
    low 0.0;
    high 1.0;
    dumpCells yes;
}

amr
{
    refineThreshold  2;
    coarsenThreshold 5;
    cycles           3;
    every            200;
    diffusion        0.05;
    dt               0.01;
}
