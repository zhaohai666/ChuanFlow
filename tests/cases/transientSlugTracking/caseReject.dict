// O2 (5.161) rejection witness: gasCap mode without an EOS gas. The
// ejection law reads the gas-cap pressure, so the loader must refuse the
// case loudly (cfFatal) instead of silently falling back.
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
}

pipe
{
    length 20;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 20;
}

closure
{
    model wallis;
    slipVelocity 0.5;
}

initial
{
    alpha 0.17082039325003;
    water 0.3;
}

slugTracking
{
    alphaThreshold 0.45;
    minLength 0.5;
    velocityMode gasCap;
    gasCapTime 5;
}

boundaries
{
    inlet { type phaseRates; vsl 0.1; vsg 0.9; }
    outlet { type fixedPressure; p 5e6; }
}

time
{
    dt 0.05;
    endTime 60;
    reportEvery 1;
}
