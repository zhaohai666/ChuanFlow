// Reject fixture: negative mass. The checker also mutates the main case to
// produce negative drag and negative inertia rejections. Each must be refused
// loudly (non-zero exit, message naming the offending parameter).
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (20 1 1);
    xmin  { name left;   type wall;     }
    xmax  { name right;  type wall;     }
    ymin  { name bottom; type symmetry; }
    ymax  { name top;    type symmetry; }
    zmin  { name front;  type empty;    }
    zmax  { name back;   type empty;    }
}

dynamicMesh
{
    meshVelocity  (0.5 0 0);
    bodyForce     (10 0 0);
    mass          -1;
    drag          1;
    inertia       0.5;
    rotDrag       0.1;
    rotStiffness  4;
    theta0        0.1;
    omega0        0;
    initialValue  7;
    dt            0.01;
    steps         10;
    reportEvery   1;
}
