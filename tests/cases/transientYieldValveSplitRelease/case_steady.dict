// transientYieldValveSplitRelease / case_steady: all seven arms with every
// schedule frozen at the K it holds at the end of the marched run -- K 0,
// because every valve here reopens by 2.7 s -- at the same iteration budget the
// earlier files use (maxIter 200).
//
// The transient file makes claims about *paths*: which drain wall goes back to
// sleep, which one is dragged under its own floor, which node freezes to a
// single printed number. This file is the same topology with the memory taken
// out, and here that is not a courtesy check -- it splits the seven arms into
// three groups, and the split is the point. Note there is ONE banner for the
// whole 19-pipe network, so the groups are read from the rows, not from the
// banner.
//
//   * `b`, `c` have a Newtonian row, so one pressure decides the node and the
//     wall that falls below its threshold simply reports no rate: Fb
//     20450.6031388 with Sb = Db = 8.84757194168e-07 m3/s (5.53's series rate)
//     and Wb at Q 0 / dp 450.60 Pa, Fc 20272.1671679 with Dc and Nc splitting
//     5.34398984438e-07 each. These two nodes print the SAME token at the
//     50000-iteration budget of case_steady_slow.dict, which is what "decided"
//     means for a single global Newton.
//   * `d`, `f`, `m` are the dead-band arms: every one of their rows is a
//     yielded wall and at the starting guess all of them are held, so
//     `Q = 0` satisfies every node row exactly. Their seven rows print Q 0 with
//     the drop the latch would also have accepted, and Fd, Ff, Fm1, Fm2 print
//     the solver's own guess 25000 = (pA + pB) / 2 -- the identical tokens in
//     the 3-arm file case_steady_dead.dict, whose banner is
//     iterations=0 residual=0 (converged). A dead band is a SET of steady
//     solutions, and only the march knows which element of it it parked in: the
//     transient left Fd at 27000.0 and Ff at 26303.12 Pa.
//   * `a` and `z` are what keeps the banner from saying converged at all: the
//     arms whose settled state is a wall sitting *just inside* its own
//     threshold. `a` needs its 8000 wall to carry a rate the bracket only
//     grants a few hundred Pa above the threshold, and `z` leaves Sz and Wz at
//     Q 0 so the only flow at that node is the 4000 drain's own
//     1.04269969255e-10 m3/s, which continuity refuses. The residual at
//     maxIter 200, 0.0321364485, IS arm a's node imbalance once the sources'
//     6e-5 scale is applied. case_steady_slow.dict is the same file with
//     maxIter 50000: Fa creeps 21898.4842293 -> 21379.7317257 (5.54's published
//     landing point for this arm) and Fz 24010.3279118 -> 24000.0401192, and
//     the residual falls to 2.6336e-11 -- still above the file's 1e-12 tol, so
//     this is a rate of convergence, and 50000 iterations of it is not a
//     refusal with a different label.
//
// verified by tests/check_transient_yield_valve_split_release.py
// (ctest verify.transientYieldValveSplitRelease).

solver
{
    type steadyNetwork;
}

fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { pressure 3.0e4; }
    B { pressure 2.0e4; }
    Fa {}; Fb {}; Fc {}; Fd {}; Ff {}; Fz {}; Fm1 {}; Fm2 {};
}

pipes
{
    Sa { from A; to Fa; length 20; diameter 0.02; yieldStress 2.0; }
    Wa { from A; to Fa; length 20; diameter 0.02; yieldStress 1.5; }
    Da { from Fa; to B; length 20; diameter 0.02; }

    Sb { from A; to Fb; length 20; diameter 0.02; yieldStress 2.0; }
    Wb { from Fb; to B; length 20; diameter 0.02; yieldStress 1.5; }
    Db { from Fb; to B; length 20; diameter 0.02; }

    Sc { from A; to Fc; length 20; diameter 0.02; yieldStress 2.0; }
    Dc { from Fc; to B; length 20; diameter 0.02; }
    Nc { from Fc; to B; length 20; diameter 0.02; }

    Sd { from A; to Fd; length 20; diameter 0.02; yieldStress 2.0; }
    Ed { from Fd; to B; length 20; diameter 0.02; yieldStress 2.0; }

    Sf { from A; to Ff; length 20; diameter 0.02; yieldStress 2.0; }
    Ef { from Ff; to B; length 20; diameter 0.02; yieldStress 1.5; }

    Sz { from A; to Fz; length 20; diameter 0.02; yieldStress 2.0; }
    Wz { from Fz; to B; length 20; diameter 0.02; yieldStress 1.5; }
    Tz { from Fz; to B; length 20; diameter 0.02; yieldStress 1.0; }

    Sm { from A; to Fm1; length 20; diameter 0.02; yieldStress 2.0; }
    Mm { from Fm1; to Fm2; length 20; diameter 0.02; }
    Em { from Fm2; to B; length 20; diameter 0.02; yieldStress 1.5; }
}

sources
{
    // A and B are the fixed-pressure nodes, so these only set the residual's
    // rate scale; they change no flow in any pipe.
    feed { node A; rate 6.0e-5; }
    take { node B; rate -6.0e-5; }
}

solve
{
    maxIter 200;
    tol 1e-12;
}
