// G2: gas-cap feedback on the terrain slug travel velocity. The same
// sealed V-chain as twoFluidTerrainSlug (50 m / 50 sections, global low
// point at arc 35 m, spill capacity cap ~= 25.019 m, sealed liquid
// alpha0 * L = 27.5 m) with the EOS gas on: pooling liquid compresses the
// trapped gas at the basin, and the captured lump travels at the
// energy-balance ejection velocity
//   u_s = sqrt(2 max(p_cap - p_front, 0) / rhoL)
// with p_cap relaxing (implicit Euler, gasCapTime) towards the EOS
// pressure of the cell at the slug rear and p_front the front cell's EOS
// pressure plus the hydrostatic head still to be lifted over the rise
// ahead. The sealed line is deliberate: an open rate-driven line vents the
// cap through the outlet, the relaxation target collapses below the front
// and the lump stalls while the inflow crushes the gas phase.
// tests/check_two_fluid_terrain_dynamic_us.py re-derives the algebraic us
// relation from the reported p profile, pcap and front every frame (1e-6),
// witnesses the clamp at maxSlugVelocity, the velocity varying with the
// terrain (not the constant-us crawl), the mean advance differing from the
// kinematic rate, the dynamicUs-false exact kinematic twin completing a
// full capture/discharge cycle (deposits counter) and the loud rejections
// (no gasR, no gasCapTime, bad word, no cycle gate).
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
    gasR 287;
}

pipes
{
    reachA { length 30; diameter 0.05; roughness 0; angleDeg -10; sections 30; }
    dropB  { length 5;  diameter 0.05; roughness 0; angleDeg -60; sections 5; }
    climbC { length 5;  diameter 0.05; roughness 0; angleDeg 60;  sections 5; }
    riseD  { length 10; diameter 0.05; roughness 0; angleDeg 5;   sections 10; }
}

closure
{
    model dynamic;
    interfacialDrag 1000;
}

initial
{
    alpha 0.55;
    water 0;
}

boundaries
{
    inlet  { type sealed; }
    outlet { type sealed; }
}

terrain
{
    minDepth 0;
    slugVelocity 0.5;
    dynamicUs true;
    gasCapTime 30;
    maxSlugVelocity 1.5;
}

time
{
    dt 0.005;
    endTime 120;
    reportEvery 200;
}
