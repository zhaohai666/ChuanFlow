# rejection variant of transientMultiSchedule: the valveSchedule events table must not be empty
fluid { rho 850; mu 0.1; }

nodes
{
    TANK { volume 5; bulkModulus 4.0e7; pressure 5.0e5; liquidFraction 0.8; }
    OUT  { fixedPressure 0; }
}

pipes
{
    LINE
    {
        from TANK; to OUT;
        length 100; diameter 0.05;
        valveSchedule
        {
            events
            {
            }
        }
    }
}

sourceSchedule
{
    node TANK;
    events
    {
        { t 0.0;  rate 0.0; }
        { t 4.0;  rate 0.002; }
        { t 9.0;  rate 0.002; }
        { t 12.0; rate 0.0; }
        { t 17.0; rate 0.001; }
    }
}


time { dt 0.02; endTime 20; reportEvery 1; }
