// Increment B (fine): the same sine field on twice as many x cells.
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (48 1 1);

    xmin  { name xmin; type wall; }
    xmax  { name xmax; type wall; }
    ymin  { name ymin; type wall; }
    ymax  { name ymax; type wall; }
    zmin  { name zmin; type symmetry; }
    zmax  { name zmax; type symmetry; }
}

velocity (1 0 0);

field
{
    profile   sine;
    axis      x;
    amplitude 1;
    waves     1;
    offset    0;
}

schemes
{
    reconstruction muscl;
    limiter       minmod;
}
