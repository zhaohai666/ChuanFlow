// transientYieldIndexValveBand / 1: what can a calendar touch once the band is
// index-blind?
//
// 5.57 split the parking band in two: the THRESHOLD (`4 tau_0 L / d`, no `n`, no
// `K`) and the `<=` that latches on it are index-blind, so n = 0.5 / 1 / 2 all
// park in the same [22000, 28000] Pa, while everything downstream of the latch
// reads the index. That left 5.56's boundary 4 open for HB walls: a valve
// schedule is a term in the SAME row as the wall law
// (`transient.cpp:363-:382`: inertia + friction + rho*K|Q|Q/2A^2 = drive), so it
// should be able to move a rate but not a threshold. Ten arms test exactly that
// split, and they test whether the split depends on the index:
//
//   * `a` 25000 plain and `h` 25000 with BOTH rows given `valve 0` +
//     close-to-1e8 + reopen -- if a held row has no K term to read
//     (`:353-:355` replaces the row with `Q = 0` before `kv` is ever used), the
//     two must agree token for token at every index;
//   * `b` 22000 and `c` 28000 are the two band edges; `b` carries the same
//     schedule on both rows, and its waking row's drive is exactly 8000 = the
//     threshold, so the calendar must not be able to wake it;
//   * sliders: `d`/`e` start 1 Pa outside the ceiling, `j`/`f` 1 Pa outside the
//     floor, `g`/`i` 2000 Pa outside the ceiling. The second of each pair carries
//     the schedule on its WAKING row only -- and because the open value is
//     `valve 0`, the scheduled arm's row is literally the unscheduled arm's row
//     until t = 0.5 s, so the two must agree token for token right up to the step
//     the ramp starts and disagree from the next one;
//   * `e` and `f` are mirrors with the same schedule: the loss term is odd in Q
//     (`|Q|Q`), so a schedule on the high side of an UP arm and the low side of a
//     DOWN arm must still print mirrored tokens.
//
// Schedule on the armed rows: `valve 0`, `valveClose {start 0.5; end 1.0;
// closedK 1.0e8}`, `valveOpen {start 2.0; end 2.5}` -- open, closing, closed,
// reopening, open again inside one 4 s file, so the same wall law can be read
// while the row is being taxed and while it is not. Geometry and rheology are
// 5.57's: L 20, d 0.02, rho 850, mu 0.1, tau_0
// 2.0, and here (`flowIndex`, `consistency`) = (1.0, 0.1). verified by
// tests/check_transient_yield_index_valve_band.py
// (ctest verify.transientYieldIndexValveBand).
//
// measured (this file, n = 1): the same desk and the same latch -- 25000 /
// 25000 / 22000 / 28000 each hold ONE token over 2001 states, arm h is arm a
// token for token (2001 node + 2001+2001 rate tokens) with the schedule on both
// of its rows, arm b HELD at i = 1 at drive exactly 8000, all 20 t = 0 flags 0.
// Here the calendar becomes visible on BOTH sliders: the far slider leaves its
// twin on step 251 (first sample past closeStart, K = 4.000e+05) and the 1 Pa
// armed arm leaves its twin's node token at step 757, 506 steps into the closed
// window; the reconstruction needs the valve term (1.001e-09 with it, 1.446e+01
// relative without). The closed valve costs 279.2209 Pa of the 1540.2417 Pa of
// approach (18.1%) and throttles 7.22x at t = 1.5 s, while the armed row's own
// wall stress stays within 10.2906% of its twin's and the valve term peaks at
// 2483.1 Pa = 31.0% of the 8000 Pa threshold. After reopening all 750 states
// flow faster than the twin (1.59..3.57x) and repay 59.6% of the debt. e/f
// mirror token for token (0.0e+00, 2001/2001) and the node rows close on printed
// tokens alone to 4.9640e-14 m3/s.

fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { fixedPressure 3.0e4; }
    B { fixedPressure 2.0e4; }

    F1a { volume 0.1; bulkModulus 1.0e8; pressure 25000.0; }
    F1h { volume 0.1; bulkModulus 1.0e8; pressure 25000.0; }
    F1b { volume 0.1; bulkModulus 1.0e8; pressure 22000.0; }
    F1c { volume 0.1; bulkModulus 1.0e8; pressure 28000.0; }

    F1d { volume 0.1; bulkModulus 1.0e8; pressure 21999.0; }
    F1e { volume 0.1; bulkModulus 1.0e8; pressure 21999.0; }
    F1j { volume 0.1; bulkModulus 1.0e8; pressure 28001.0; }
    F1f { volume 0.1; bulkModulus 1.0e8; pressure 28001.0; }
    F1g { volume 0.1; bulkModulus 1.0e8; pressure 20000.0; }
    F1i { volume 0.1; bulkModulus 1.0e8; pressure 20000.0; }
}

pipes
{
    S1a { from A; to F1a; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
    E1a { from F1a; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }

    S1h { from A; to F1h; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E1h { from F1h; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }

    S1b { from A; to F1b; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E1b { from F1b; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }

    S1c { from A; to F1c; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
    E1c { from F1c; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }

    S1d { from A; to F1d; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
    E1d { from F1d; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }

    S1e { from A; to F1e; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E1e { from F1e; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }

    S1j { from A; to F1j; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
    E1j { from F1j; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }

    S1f { from A; to F1f; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
    E1f { from F1f; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }

    S1g { from A; to F1g; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
    E1g { from F1g; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }

    S1i { from A; to F1i; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0;
              valve 0.0;
              valveClose { start 0.5; end 1.0; closedK 1.0e8; }
              valveOpen { start 2.0; end 2.5; } }
    E1i { from F1i; to B; length 20; diameter 0.02;
              flowIndex 1.0; consistency 0.1; yieldStress 2.0; }
}

time
{
    dt 0.002; endTime 4.0; reportEvery 1;
}
