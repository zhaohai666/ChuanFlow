// E6 (5.176) byte-identity witness: case.dict WITHOUT the pigging block.
// The pig reads the field but never writes it, so the whole physics report
// must be byte-for-byte identical to the declared run once `pig` lines are
// stripped. The checker diffs the two full reports.
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
}

pipe
{
    length 20;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 20;
}

closure
{
    model wallis;
    slipVelocity 0.5;
}

initial
{
    alpha 0.61803398875;
    water 0.3;
}

boundaries
{
    inlet
    {
        type phaseRates;
        vsl 0.5;
        vsg 0.5;
        waterFraction 0.3;
        schedule
        {
            p1 { t 3; vsl 0.8; vsg 0.2; }
            p2 { t 7; vsl 0.5; vsg 0.5; }
        }
    }
    outlet { type fixedPressure; p 5e6; }
}

time
{
    dt 0.05;
    endTime 20;
    reportEvery 1;
}
