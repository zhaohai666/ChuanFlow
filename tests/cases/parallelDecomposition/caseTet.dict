// The same decomposition contract on a mesh the block mesher cannot make: a
// unit cube of Gmsh tetrahedra, whose cells have triangular faces, no opposite
// pairs and non-orthogonal owner-neighbour lines. Nothing about the partition,
// the halo or the flux bookkeeping may lean on a hex grid, so this case runs the
// identical checks on it: faces reassemble, the decomposed sweep equals the
// serial one exactly, and a divergence-free field still gives every interior
// cell a zero net out-flux across a cut.
//
// What is NOT asserted here is the accuracy of the gradient. On 95 tetrahedra of
// a unit cube the serial corrected scheme does not reproduce even a linear
// field's gradient (it reports gradAnalytic ~5.7 linear / ~217 corrected),
// because the bounded owner weights clamp on these skewed faces -- a property of
// the scheme on this mesh, present at one domain and therefore owed only to the
// scheme, not to the cut. The checker reads that number as a note and holds the
// decomposition to what it can promise: the very same (bad) gradient, bit for
// bit, for 1, 3, 7 and 13 domains.
mesh
{
    format gmsh;
    file "../../meshes/cubeTets_22.msh";

    patches
    {
        s101 { type wall; }
        s102 { type wall; }
        s103 { type wall; }
        s104 { type wall; }
        s105 { type wall; }
        s106 { type wall; }
    }
}

decompose
{
    domains (1 3 7 13);
}

field
{
    linear    (1 2 -1 0.5 0 0 0 0 0 0);
    quadratic (1 2 -1 0.5 3 -0.25 0 1.5 -2 0.75);
}

verify
{
    // no gradAnalytic tolerance: see the header, this mesh's own scheme error is
    // reported as a note and only required not to change with the cut
    stencilDevTol     0;
    domainCountDevTol 0;
    divInteriorTol    1e-13;
}

output
{
    vtk out_parallelTet.vtu;
}
