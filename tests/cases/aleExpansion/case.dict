// aleExpansion: a 1D slab whose vertices move with U_m = rate*x (rate = 1/s),
// so the domain length grows as (1 + rate*t). Each cell volume grows as the
// cube of the stretch factor in 3D (only x stretches here: linearly). The
// GCL residual dV/dt - sum(U_m.Sf) is O(dt) for a forward-Euler step with
// face velocities sampled at the old time; the checker verifies it is small
// and halves when dt halves (translation is the exact roundoff anchor).
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (20 1 1);
    xmin  { name left;   type wall;     }
    xmax  { name right;  type wall;     }
    ymin  { name bottom; type symmetry; }
    ymax  { name top;    type symmetry; }
    zmin  { name front;  type empty;    }
    zmax  { name back;   type empty;    }
}

ale
{
    motion expand;
    expansionRate 1.0;
    dt 0.01;
    steps 10;
    reportEvery 1;
}
