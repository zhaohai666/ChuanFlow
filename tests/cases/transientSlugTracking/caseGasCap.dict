// O2 (5.161) variant: the same two-pulse timeline but with the front
// migration velocity closed by the 5.142 gas-cap ejection law instead of
// the constant. The EOS gas (gasR 287) prices the cap pocket behind each
// tracked rear; the checker re-derives the relaxation and the ejection
// sqrt(2 max(p_cap - p_front, 0)/rho_L) from the reported p profile on
// every frame.
fluid
{
    rhoL 1000;
    rhoG 20;
    muL  0.01;
    muG  1e-5;
    gasR 287;
}

pipe
{
    length 20;
    diameter 0.1;
    roughness 0;
    angleDeg 0;
    sections 20;
}

closure
{
    model wallis;
    slipVelocity 0.5;
}

initial
{
    alpha 0.17082039325003;
    water 0.3;
}

slug
{
    alphaThreshold 0.45;
    minLength 0.5;
}

slugTracking
{
    enable true;
    alphaThreshold 0.45;
    minLength 0.5;
    velocityMode gasCap;
    gasCapTime 5;
    maxSlugVelocity 2;
}

boundaries
{
    inlet
    {
        type phaseRates;
        vsl 0.1;
        vsg 0.9;
        waterFraction 0.3;
        schedule
        {
            p1 { t 5;  vsl 0.75; vsg 0.25; }
            p2 { t 10; vsl 0.1;  vsg 0.9; }
            p3 { t 12; vsl 0.75; vsg 0.25; }
            p4 { t 17; vsl 0.1;  vsg 0.9; }
        }
    }
    outlet { type fixedPressure; p 5e6; }
}

time
{
    dt 0.05;
    endTime 60;
    reportEvery 1;
}
