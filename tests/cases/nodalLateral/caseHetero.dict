// 5.157 (P5): multi-lateral nodal analysis with heterogeneous IPRs. The
// three laterals carry a linear (Darcy), a Jones (Rawlins-Schellhardt) and a
// Vogel inflow curve - the branch forms, and the form against the main
// ipr{}, are never required to agree: each branch brings its own inflow
// physics to the same junction fixed point.
fluid
{
    blackoil
    {
        gasGravity     0.65;
        oilDensity     850;
        gor            90;    // sm3/sm3
        waterCut       0;
        temperature    340;   // K, isothermal
        surfaceTension 0.03;  // N/m
    }
}

ipr
{
    form              vogel;
    reservoirPressure 2.2e7;  // Pa (the main bore is a lift conduit: unused)
    maxRate           0.006;  // sm3/s
}

well
{
    length    2400;    // m, measured depth of the main bore
    diameter  0.062;   // m
    roughness 4.6e-5;  // m
    elevation 2200;    // m, wellhead above the junction
}

laterals
{
    L1
    {
        ipr
        {
            form              linear;
            reservoirPressure 2.6e7;
            productivityIndex 8.0e-11;  // sm3/(s Pa), AOF 2.08e-3
        }
        well
        {
            length    500;
            diameter  0.05;
            roughness 4.6e-5;
            elevation 400;
        }
    }
    L2
    {
        ipr
        {
            form              jones;
            reservoirPressure 2.4e7;
            deliverability    5.0e-18;  // sm3/(s Pa^2) at n = 1, AOF 2.88e-3
            exponent          1;
        }
        well
        {
            length    600;
            diameter  0.05;
            roughness 4.6e-5;
            elevation 500;
        }
    }
    L3
    {
        ipr
        {
            form              vogel;
            reservoirPressure 2.5e7;
            maxRate           0.002;
        }
        well
        {
            length    450;
            diameter  0.045;
            roughness 4.6e-5;
            elevation 350;
        }
    }
}

wellheadPressure 2.5e6;  // Pa, the separator holds the tubing head

solve
{
    maxIter 100;
    tol     1e-9;
}
