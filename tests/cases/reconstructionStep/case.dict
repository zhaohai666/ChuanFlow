// Increment C: a discontinuity. T = (x < 0.5) ? 0 : 1.
// MUSCL face values must stay inside [min(U,D), max(U,D)] (no overshoot),
// while the unlimited backward extrapolation overshoots at the first cell
// downstream of the jump. minmod keeps the step monotone.
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (16 1 1);

    xmin  { name xmin; type wall; }
    xmax  { name xmax; type wall; }
    ymin  { name ymin; type wall; }
    ymax  { name ymax; type wall; }
    zmin  { name zmin; type symmetry; }
    zmax  { name zmax; type symmetry; }
}

velocity (1 0 0);

field
{
    profile   step;
    axis      x;
    threshold 0.5;
    low       0;
    high      1;
}

schemes
{
    reconstruction muscl;
    limiter       minmod;
}
