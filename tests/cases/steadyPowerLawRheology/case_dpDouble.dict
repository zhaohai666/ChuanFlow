// steadyPowerLawRheology, second driving difference: p(A) 4.0e4 instead of
// 3.0e4, so every pipe now carries dp = 2.0e4 -- exactly twice case.dict.
// Nothing else changes: same nine pipes, same K, same n, same geometry.
// The only thing this file exists to measure is the exponent Q ~ dp^(1/n),
// which is the statement that a shear-thinning pipe is not a fixed resistance
// but a rate-dependent one: Newtonian 2x dp -> 2x Q, n = 0.5 -> 4x, n = 1.3
// -> 1.7x. Read as ratios against case.dict in the checker.
fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { pressure 4.0e4; }
    B { pressure 2.0e4; }
}

pipes
{
    Newt  { from A; to B; length 20; diameter 0.02; }
    PowN1 { from A; to B; length 20; diameter 0.02;
            flowIndex 1; consistency 0.1; }

    Thin05  { from A; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; }
    Thin07  { from A; to B; length 20; diameter 0.02;
              flowIndex 0.7; consistency 2.0; }
    Thick13 { from A; to B; length 20; diameter 0.02;
              flowIndex 1.3; consistency 0.02; }

    D2xNewt { from A; to B; length 20; diameter 0.04; }
    D2xThin { from A; to B; length 20; diameter 0.04;
              flowIndex 0.5; consistency 1.0; }

    LongNewt { from A; to B; length 40; diameter 0.02; }
    LongThin { from A; to B; length 40; diameter 0.02;
               flowIndex 0.5; consistency 1.0; }
}

solve { maxIter 60; tol 1e-12; }
