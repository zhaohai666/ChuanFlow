// 反向：流量是给定的，压差才是未知数。定压节点 K = 2.0e4，两条同几何的屈服管
// 各自接一个自由节点，节点上注入/取出 5.0e-6 m3/s，于是 Newton 必须解出该速率
// 对应的墙应力解——这条和 case.dict 的"两端定压"（dp 已知、q 未知）正好互为反问题，
// 用来证明死分支只在括号之前判一次，没有把正/反两个方向都靠运气走对。
// verified by tests/check_steady_bingham_yield.py (ctest verify.steadyBinghamYield).
fluid
{
    rho 850;
    mu 0.1;
}

nodes
{
    K { pressure 2.0e4; }
    J {};
    Jr {};
}

pipes
{
    // 注入 5.0e-6 -> J 侧压力被抬到阈值以上，正向流动
    Yf  { from J;  to K; length 20; diameter 0.02; yieldStress 1.0; }
    // 取出 5.0e-6 -> 同一条律反着走（forward 分支的符号由 g(0) 选）
    Yr  { from Jr; to K; length 20; diameter 0.02; yieldStress 1.0; }
}

sources
{
    in  { node J;  rate 5.0e-6; }
    out { node Jr; rate -5.0e-6; }
}

solve
{
    maxIter 60;
    tol 1e-12;
}
