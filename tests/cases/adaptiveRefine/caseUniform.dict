// F13 uniform twin: a constant scalar field (linear with zero gradient).
// Its gradient indicator is exactly zero, so no cell may be refined and the
// reported level must stay at 0 regardless of maxDepth or threshold.
block
{
    min  (0 0 0);
    max  (1 1 0.1);
    cells (8 8 1);
}

adapt
{
    gradientThreshold 3;
    maxDepth 3;
    field linear;
    gradient (0 0 0);
    offset 3.5;
}
