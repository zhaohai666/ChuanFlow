// transientYieldIndexParkingBand / 5: does the parking lot know the flow index?
//
// 5.56 swept a Bingham node's own start across its band and found the tail to be
// quadratic in the excess -- `1 - 4x/3 + x^4/3` loses BOTH its constant and its
// linear term at x = 1 -- which is why `1/gap` is a straight line. That
// cancellation is a property of the exponent, not of the dead band, so the
// question this file asks is which half of 5.56 survives when the wall law is
// Herschel-Bulkley, `tau = tau_0 + K gammas^n`:
//
//   * the THRESHOLD is geometry only (`4 tau_0 L / d`, no `n`, no `K`), so the
//     band should be the SAME [pA - 8000, pB + 8000] = [22000, 28000] Pa for
//     every index, and the two edge arms should still be held by `<=`;
//   * the TAIL should change. The HB section integral near threshold is
//     Q = (pi R^3 / (tau_0 K^(1/n))) (n/(n+1)) (d/4L)^m gap^m with m = (n+1)/n,
//     so the excess decays with exponent m -- 3 for n=0.5, 2 for n=1 (5.56's
//     number, reproduced here), 1.5 for n=2 -- and the straight line moves from
//     `1/gap` to `gap^(-1/n)`, whose slope is A_n/n with
//     A_n = (pi R^3 / (tau_0 K^(1/n))) (n/(n+1)) (d/4L)^m / Cc.
//
// Seven starts per index -- `a` 25000 parked, `b`/`c` the two edges parked,
// `d`/`f` one Pa outside, `e`/`g` 2000 Pa outside -- and the three fluids differ
// only in (`flowIndex`, `consistency`) = (0.5, 1.0), (1.0, 0.1), (2.0, 0.02) with
// `tau_0 = 2.0` everywhere. verified by
// tests/check_transient_yield_index_parking_band.py
// (ctest verify.transientYieldIndexParkingBand).
//
// measured: the three starts inside the band print ONE token each
// (25000 / 22000 / 28000) over 2001 states and the edge arms b/c are HELD on the
// very first decision, drive exactly 8000 = 4 tau_0 L / d, so the desk and the
// `<=` that guards it are both index-blind. The 2000 Pa sliders e/g slide
// through all 2001 tokens, strictly monotone and never reaching the band, while
// the 1 Pa sliders d/f print ONE token each in this file: at m = 3 a slider and
// a parked start are the same printout until the clock is lengthened, which is
// what case_long_5 is for. Arms d/f and e/g mirror token for token -- node
// pressures sum to 50000 Pa within 0.0e+00 and the waking rates are identical in
// 2001/2001 states -- and t = 0 prints 14 hold flags, every one of them 0.

fluid
{
    rho 850; mu 0.1;
}

nodes
{
    A { fixedPressure 3.0e4; }
    B { fixedPressure 2.0e4; }


    F5a { volume 0.1; bulkModulus 1.0e8; pressure 25000.0; }

    F5b { volume 0.1; bulkModulus 1.0e8; pressure 22000.0; }

    F5c { volume 0.1; bulkModulus 1.0e8; pressure 28000.0; }

    F5d { volume 0.1; bulkModulus 1.0e8; pressure 21999.0; }

    F5e { volume 0.1; bulkModulus 1.0e8; pressure 20000.0; }

    F5f { volume 0.1; bulkModulus 1.0e8; pressure 28001.0; }

    F5g { volume 0.1; bulkModulus 1.0e8; pressure 30000.0; }
}

pipes
{
    S5a { from A; to F5a; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5a { from F5a; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    S5b { from A; to F5b; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5b { from F5b; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    S5c { from A; to F5c; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5c { from F5c; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    S5d { from A; to F5d; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5d { from F5d; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    S5e { from A; to F5e; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5e { from F5e; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    S5f { from A; to F5f; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5f { from F5f; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    S5g { from A; to F5g; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
    E5g { from F5g; to B; length 20; diameter 0.02;
              flowIndex 0.5; consistency 1.0; yieldStress 2.0; }
}

time
{
    dt 0.002; endTime 4.0; reportEvery 1;
}
