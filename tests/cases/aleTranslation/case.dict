// aleTranslation: a 1D slab whose vertices all translate at 1 m/s in x.
// The mesh geometry is rigid, so every face's Sf is constant and the mesh
// volume flux sum(U_m.Sf) over a closed cell is exactly zero: dV/dt = 0 must
// hold to roundoff. The checker verifies max|GCL| ~ 1e-15 (machine precision)
// for every cell at every step, and that the whole mesh translates rigidly.
block
{
    min   (0 0 0);
    max   (1 0.1 0.1);
    cells (20 1 1);
    xmin  { name left;   type wall;     }
    xmax  { name right;  type wall;     }
    ymin  { name bottom; type symmetry; }
    ymax  { name top;    type symmetry; }
    zmin  { name front;  type empty;    }
    zmax  { name back;   type empty;    }
}

ale
{
    motion translate;
    translation (1 0 0);
    dt 0.1;
    steps 10;
    reportEvery 1;
}
